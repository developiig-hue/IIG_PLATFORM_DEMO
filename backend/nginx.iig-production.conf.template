# IIG production reverse proxy template
# Replace CHANGE_ME_DOMAIN and certificate paths, or manage TLS with your hosting panel/Certbot.

server {
    listen 80;
    listen [::]:80;
    server_name CHANGE_ME_DOMAIN www.CHANGE_ME_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name CHANGE_ME_DOMAIN www.CHANGE_ME_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/CHANGE_ME_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/CHANGE_ME_DOMAIN/privkey.pem;

    server_tokens off;
    client_max_body_size 25m;

    # Static public IIG site deployment directory.
    root /srv/iig/public;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    location /admin/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-IIG-Admin-Role "";
        proxy_set_header X-IIG-Proxy-Secret "";
        add_header Cache-Control "no-store" always;
    }

    location /api/v1/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-IIG-Admin-Role "";
        proxy_set_header X-IIG-Proxy-Secret "";
        proxy_request_buffering off;
        add_header Cache-Control "no-store" always;
    }

    location = /unsubscribe {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /digest/current.pdf {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }
    location = /digest/current-en.pdf {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Never expose source/admin infrastructure files.
    location ~ ^/(backend|scripts|docs|config|\.github|\.git)/ { deny all; return 404; }
    location ~ /\.(env|git|DS_Store) { deny all; return 404; }
}
