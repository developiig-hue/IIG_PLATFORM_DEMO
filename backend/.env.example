# IIG Digest Publication Service
PORT=8787
HOST=0.0.0.0
PUBLIC_BASE_URL=https://www.example.com

# local | s3
IIG_DIGEST_STORAGE=local

# LOCAL storage
IIG_DIGEST_LOCAL_DIR=./data/digest

# S3-compatible storage
IIG_S3_BUCKET=iig-digest
IIG_S3_REGION=auto
IIG_S3_ENDPOINT=
IIG_S3_ACCESS_KEY_ID=
IIG_S3_SECRET_ACCESS_KEY=
IIG_S3_FORCE_PATH_STYLE=false

# Secure Admin authentication: /admin/ -> Password -> MFA -> HttpOnly session -> RBAC.
# Password hashes use: scrypt$N$r$p$salt_base64url$hash_base64url
# Generate offline, e.g. by importing scryptHash() from src/session-auth.mjs.
IIG_ADMIN1_USERNAME=admin1
IIG_ADMIN1_PASSWORD_HASH=
IIG_ADMIN1_MFA_SECRET=
IIG_ADMIN1_DISPLAY_NAME=ADMIN_1
IIG_ADMIN2_USERNAME=admin2
IIG_ADMIN2_PASSWORD_HASH=
IIG_ADMIN2_MFA_SECRET=
IIG_ADMIN2_DISPLAY_NAME=ADMIN_2
IIG_AUTH_DIR=./var/auth
IIG_AUDIT_DIR=./var/audit
IIG_AUTH_IP_SALT=change-me
IIG_SESSION_TTL_MINUTES=30
IIG_SESSION_ABSOLUTE_HOURS=12
IIG_COOKIE_SECURE=true
IIG_ADMIN_UI_DIR=/app/admin-ui

# Legacy bearer tokens are disabled by default. Enable only during a controlled migration.
IIG_ALLOW_LEGACY_ADMIN_TOKENS=false
IIG_ADMIN1_TOKEN=
IIG_ADMIN2_TOKEN=
IIG_TRUSTED_PROXY_SECRET=
IIG_ALLOW_TRUSTED_PROXY_AUTH=false

# CORS/host policy: comma-separated exact origins. Empty = same-origin only.
IIG_ALLOWED_ORIGINS=https://www.example.com,https://example.com

# Editorial Robot dispatch (server-side only)
IIG_GITHUB_REPO=developiig-hue/IIG_PLATFORM_DEMO
IIG_GITHUB_EDITORIAL_WORKFLOW=editorial-refresh.yml
IIG_GITHUB_BRANCH=main
IIG_GITHUB_ACTIONS_TOKEN=

# Persistent ADMIN_2/ADMIN_1 editorial draft storage
IIG_EDITORIAL_DRAFT_DIR=./var/editorial-drafts

# Public requests / subscriptions registry (PII; private persistent storage only)
IIG_REQUESTS_DIR=./var/requests
# Change in production; used only to hash source IP for abuse diagnostics
IIG_REQUESTS_IP_SALT=change-me

# IIG Digest mailing transport (server-side only)
IIG_SMTP_HOST=
IIG_SMTP_PORT=587
IIG_SMTP_SECURE=false
IIG_SMTP_USER=
IIG_SMTP_PASS=
IIG_MAIL_FROM="IIG Monthly Digest <digest@iig.energy>"
IIG_MAIL_TEST_TO=

# Persistent mailing campaign ledger
IIG_MAILING_DIR=./var/mailing

# Long random secret used to sign unsubscribe links. REQUIRED in production.
IIG_UNSUBSCRIBE_SECRET=change-me-to-a-long-random-secret

# RADAR server-to-server bridge
IIG_RADAR_UPSTREAM_URL=
IIG_RADAR_SERVICE_TOKEN=

# Never enable outside automated tests
IIG_E2E_MODE=false
