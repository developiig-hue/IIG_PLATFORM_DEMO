# IIG Digest Publication Service
PORT=8787
HOST=0.0.0.0
PUBLIC_BASE_URL=https://www.example.com

# local | s3
IIG_DIGEST_STORAGE=local

# LOCAL storage
IIG_DIGEST_LOCAL_DIR=./data/digest

# S3-compatible storage
IIG_S3_BUCKET=iig-digest
IIG_S3_REGION=auto
IIG_S3_ENDPOINT=
IIG_S3_ACCESS_KEY_ID=
IIG_S3_SECRET_ACCESS_KEY=
IIG_S3_FORCE_PATH_STYLE=false

# Authentication.
# Preferred on paid hosting: trusted reverse proxy injects X-IIG-Admin-Role.
# Optional direct bearer tokens:
IIG_ADMIN1_TOKEN=
IIG_ADMIN2_TOKEN=

# CORS/host policy: comma-separated exact origins. Empty = same-origin only.
IIG_ALLOWED_ORIGINS=https://www.example.com,https://example.com

# Editorial Robot dispatch (server-side only)
IIG_GITHUB_REPO=developiig-hue/IIG_PLATFORM_DEMO
IIG_GITHUB_EDITORIAL_WORKFLOW=editorial-refresh.yml
IIG_GITHUB_BRANCH=main
IIG_GITHUB_ACTIONS_TOKEN=

# Persistent ADMIN_2/ADMIN_1 editorial draft storage
IIG_EDITORIAL_DRAFT_DIR=./var/editorial-drafts

# Public requests / subscriptions registry (PII; private persistent storage only)
IIG_REQUESTS_DIR=./var/requests
# Change in production; used only to hash source IP for abuse diagnostics
IIG_REQUESTS_IP_SALT=change-me

# IIG Digest mailing transport (server-side only)
IIG_SMTP_HOST=
IIG_SMTP_PORT=587
IIG_SMTP_SECURE=false
IIG_SMTP_USER=
IIG_SMTP_PASS=
IIG_MAIL_FROM="IIG Monthly Digest <digest@example.com>"
IIG_MAIL_TEST_TO=

# Persistent mailing campaign ledger
IIG_MAILING_DIR=./var/mailing

# Long random secret used to sign unsubscribe links. REQUIRED in production.
IIG_UNSUBSCRIBE_SECRET=change-me-to-a-long-random-secret
