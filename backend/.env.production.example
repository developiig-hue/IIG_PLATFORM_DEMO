# IIG production backend — COPY to backend/.env.production and replace every CHANGE_ME.
NODE_ENV=production
PORT=8787
HOST=0.0.0.0

# Canonical public domain
PUBLIC_BASE_URL=https://CHANGE_ME_DOMAIN
IIG_ALLOWED_ORIGINS=https://CHANGE_ME_DOMAIN,https://www.CHANGE_ME_DOMAIN
IIG_COOKIE_SECURE=true
IIG_ADMIN_UI_DIR=/app/admin-ui

# Persistent private filesystem storage (mounted Docker volume)
IIG_AUTH_DIR=/app/var/auth
IIG_AUDIT_DIR=/app/var/audit
IIG_REQUESTS_DIR=/app/var/requests
IIG_EDITORIAL_DRAFT_DIR=/app/var/editorial-drafts
IIG_MAILING_DIR=/app/var/mailing
IIG_DIGEST_LOCAL_DIR=/app/data/digest
IIG_DIGEST_STORAGE=local

# PostgreSQL foundation / future structured migration
POSTGRES_DB=iig
POSTGRES_USER=iig
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DB_PASSWORD
IIG_DATABASE_URL=postgresql://iig:CHANGE_ME_LONG_RANDOM_DB_PASSWORD@postgres:5432/iig

# ADMIN secure auth
IIG_ADMIN1_USERNAME=CHANGE_ME
IIG_ADMIN2_USERNAME=CHANGE_ME
IIG_ADMIN1_PASSWORD_HASH=CHANGE_ME_SCRYPT_HASH
IIG_ADMIN2_PASSWORD_HASH=CHANGE_ME_SCRYPT_HASH
IIG_ADMIN1_MFA_SECRET=CHANGE_ME_BASE32
IIG_ADMIN2_MFA_SECRET=CHANGE_ME_BASE32
IIG_ADMIN1_DISPLAY_NAME=ADMIN_1
IIG_ADMIN2_DISPLAY_NAME=ADMIN_2
IIG_AUTH_IP_SALT=CHANGE_ME_LONG_RANDOM
IIG_SESSION_TTL_MINUTES=30
IIG_SESSION_ABSOLUTE_HOURS=12
IIG_ALLOW_LEGACY_ADMIN_TOKENS=false
IIG_ALLOW_TRUSTED_PROXY_AUTH=false
IIG_TRUSTED_PROXY_SECRET=

# Requests / abuse diagnostics
IIG_REQUESTS_IP_SALT=CHANGE_ME_LONG_RANDOM

# Editorial robot dispatch
IIG_GITHUB_REPO=developiig-hue/IIG_PLATFORM_DEMO
IIG_GITHUB_EDITORIAL_WORKFLOW=editorial-refresh.yml
IIG_GITHUB_BRANCH=main
IIG_GITHUB_ACTIONS_TOKEN=CHANGE_ME_SERVER_SIDE_ONLY

# SMTP
IIG_SMTP_HOST=CHANGE_ME
IIG_SMTP_PORT=587
IIG_SMTP_SECURE=false
IIG_SMTP_USER=CHANGE_ME
IIG_SMTP_PASS=CHANGE_ME
IIG_MAIL_FROM="IIG Monthly Digest <digest@iig.energy>"
IIG_MAIL_TEST_TO=
IIG_UNSUBSCRIBE_SECRET=CHANGE_ME_64_PLUS_RANDOM_CHARS

# RADAR — stable private provider/service; never expose token to browser.
# Backend Admin UI always calls same-origin /api/v1/radar/runs.
IIG_RADAR_SEARCH_ENDPOINT=https://CHANGE_ME_STABLE_RADAR_PROVIDER
IIG_RADAR_SEARCH_TOKEN=CHANGE_ME_SERVER_SIDE_ONLY
IIG_RADAR_HTTP_TIMEOUT_MS=120000

# Optional S3-compatible Digest storage.
# Set IIG_DIGEST_STORAGE=s3 to enable.
IIG_S3_BUCKET=
IIG_S3_REGION=auto
IIG_S3_ENDPOINT=
IIG_S3_ACCESS_KEY_ID=
IIG_S3_SECRET_ACCESS_KEY=
IIG_S3_FORCE_PATH_STYLE=false
