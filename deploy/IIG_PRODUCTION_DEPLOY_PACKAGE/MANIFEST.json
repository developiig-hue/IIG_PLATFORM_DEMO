  "startup_commands": [
    "cp backend/.env.production.example backend/.env.production",
    "python3 deploy/IIG_PRODUCTION_DEPLOY_PACKAGE/verify_freeze.py",
    "docker compose -f backend/docker-compose.production.yml --env-file backend/.env.production config",
    "docker compose -f backend/docker-compose.production.yml --env-file backend/.env.production build --pull",
    "docker compose -f backend/docker-compose.production.yml --env-file backend/.env.production up -d",
    "curl -fsS http://127.0.0.1:8787/healthz",
    "curl -fsS https://HOSTNAME/readyz"
  ],
  "package_builder": "deploy/IIG_PRODUCTION_DEPLOY_PACKAGE/assemble.sh",
  "package_gate": "deploy/IIG_PRODUCTION_DEPLOY_PACKAGE/verify_freeze.py",
  "hard_rules": [
    "GitHub Pages is backup/CI only after cutover",
    "Production /admin/ is backend-owned and must not be copied into public static root",
    "No real secret may be committed to repository or deploy package",
    "HARD RULE migration contracts remain authoritative",
    "Future public IIG MARKET concept is not activated by this freeze"
  ],
  "migration_locked_rules": [
