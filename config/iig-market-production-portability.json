  "migration_gate": [
    "HTTPS",
    "DB_PERSISTENCE",
    "MEDIA_PERSISTENCE",
    "PASSWORD_MFA_SESSION",
    "BACKEND_RBAC",
    "AUDIT",
    "BACKUP_RESTORE",
    "SELLER_PRIVATE_ISOLATION",
    "PRICE_APPROVAL",
    "TERMS_VERSIONING",
    "BUYER_INQUIRY",
    "NO_AUTO_DIGEST_PAGE",
    "MANUAL_DIGEST_COMPOSER",
    "EXACT_LISTING_LINKS",
