    "after": "НОВИНИ",
    "before": "ДАЙДЖЕСТ"
  },
  "equipment_statuses": [
    "DRAFT",
    "ADMIN_2_PREPARED",
    "TECHNICAL_REVIEW",
    "READY_FOR_ADMIN_1",
    "ADMIN_1_APPROVED",
    "PUBLISHED",
    "RESERVED",
    "SOLD",
    "ARCHIVED"
  ],
  "condition_badges": [
    "NEW",
    "Б/У",
    "REFURBISHED",
    "NEVER INSTALLED"
  ],
  "price_modes": [
    "FIXED PRICE",
    "PRICE RANGE",
    "FROM",
    "ON REQUEST"
  ],
  "rights": {
    "ADMIN_2": [
      "create",
      "edit",
      "media",
      "technical_parameters",
      "condition",
      "seller_private",
      "prepare_price",
      "buyer_requests",
      "draft_terms",
      "preview"
